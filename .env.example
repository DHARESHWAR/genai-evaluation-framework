# Agent config
GROQ_API_KEY=
AGENT_MODEL=llama-3.1-70b-versatile
AGENT_BASE_URL=https://api.groq.com/openai/v1

# Judge config (use a different model family to avoid self-preference bias)
JUDGE_MODEL=llama-3.1-8b-instant
JUDGE_BASE_URL=https://api.groq.com/openai/v1
JUDGE_API_KEY=

# Evaluation config
AGENT_ENDPOINT=http://localhost:8000
BATCH_SIZE=10
